# ==============================================================================
# NEXA POS 100-Year Cloud Server - Environment Variables Configuration
# ==============================================================================

# بيئة التشغيل ومنفذ الخادم الداخلي
NODE_ENV=production
PORT=4000

# إعدادات قاعدة بيانات PostgreSQL السحابية
POSTGRES_DB=nexa_saas
POSTGRES_USER=nexa_admin
POSTGRES_PASSWORD=replace_with_strong_password_minimum_32_chars

# إعدادات محرك الكاش Redis
REDIS_PASSWORD=replace_with_strong_redis_password_minimum_32_chars

# المفاتيح التشفيرية لتوليد والتحقق من التراخيص والـ JWT
JWT_SECRET=replace_with_openssl_rand_hex_32_secret
LICENSE_SIGNING_KEY=replace_with_openssl_rand_hex_32_private_key

# نطاق السيرفر لتفعيل شهادات SSL (اختياري / حسب حجزك على Hostinger)
DOMAIN_NAME=pos.yourdomain.com
EOF

# Prometheus scraper token for /metrics (without it only the server itself may read the metrics)
METRICS_TOKEN=
