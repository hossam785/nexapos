        <SectionCard title="تذ�`�`� ا�فات��رة" icon={FileText}>
          <Textarea
            rows={3}
            value={settings.invoice_footer}
            onChange={e => set('invoice_footer', e.target.value)}
            placeholder="شْرا�9 ï¿½ز�`ارتْ�&... ï¿½ ع�&� ع�ï¿½0 �&دار ا�ساعة"
          />
          <p className="text-xs text-slate-400 mt-2">�`ظ�!ر �!ذا ا�ï¿½ ص ف�` أسف� ْ� فات��رة �&طب��عة</p>
        </SectionCard>

        <SectionCard title="إعدادات ا�ص�اح�`ة ��ا�دفعات" icon={Calendar}>
          <div className="space-y-4">
            <div className="p-4 rounded-xl bg-blue-50 border border-blue-100">
              <p className="text-xs font-bold text-blue-700 mb-1">ï¿½ ظا�& Batch / Lot</p>
              <p className="text-xs text-slate-500 leading-relaxed">
                �`�&ْ� ْ تفع�`� تتبع ت��ار�`خ ا�إ� تاج ��ا�ا� ت�!اء ï¿½ْ� ï¿½&ï¿½ تج ï¿½&ï¿½  خ�ا� صفحة ا�ï¿½&ï¿½ تجات ï¿½ ï¿½ زر "إدارة ا�دفعات".
                ا�إعداد ï¿½!ï¿½ ا �`حدد عدد ا�أ�`ا�& ا�ت�` �`بدأ ف�`�!ا ا�ï¿½ ظا�& بإرسا� ت� ب�`�! �ب� ا� ت�!اء ا�ص�اح�`ة.
              </p>
