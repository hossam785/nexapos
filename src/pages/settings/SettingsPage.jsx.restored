]

// ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½
// Reusable UI components
// ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½
function SectionCard({ title, icon: Icon, iconColor = 'text-blue-700', children, accent }) {
  return (
    <div className={`bg-white rounded-2xl shadow-sm border ${accent ? accent : 'border-slate-100'} p-6`}>
      <div className={`flex items-center gap-2.5 mb-5 ${iconColor}`}>
        {Icon && <Icon size={20} />}
        <h3 className="font-bold text-slate-800 text-base">{title}</h3>
      </div>
      {children}
    </div>
  )
}

function FieldLabel({ children }) {
  return <label className="block text-sm font-semibold text-slate-500 mb-1.5">{children}</label>
}

function Input({ label, ...props }) {
  return (
    <div>
      {label && <FieldLabel>{label}</FieldLabel>}
      <input
        {...props}
        className="w-full border border-slate-200 bg-slate-50/60 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-700/30 focus:border-blue-600 transition placeholder-slate-300"
      />
    </div>
  )
}

function Select({ label, children, ...props }) {
  return (
    <div>
      {label && <FieldLabel>{label}</FieldLabel>}
      <select
        {...props}
        className="w-full border border-slate-200 bg-slate-50/60 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-700/30 focus:border-blue-600 transition"
      >
        {children}
      </select>
    </div>
  )
}

function Textarea({ label, ...props }) {
  return (
    <div>
      {label && <FieldLabel>{label}</FieldLabel>}
      <textarea
        {...props}
        className="w-full border border-slate-200 bg-slate-50/60 rounded-xl px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-700/30 focus:border-blue-600 transition resize-none placeholder-slate-300"
      />
    </div>
  )
}

function Toggle({ label, description, checked, onChange }) {
  return (
    <div className="flex items-center justify-between gap-4 py-3 border-b border-slate-50 last:border-0">
      <div className="flex-1 min-w-0">
        <p className="text-sm font-semibold text-slate-700 leading-tight">{label}</p>
        {description && <p className="text-xs text-slate-400 mt-0.5 leading-relaxed">{description}</p>}
      </div>
      <button
        onClick={() => onChange(!checked)}
        className={`relative flex-shrink-0 w-12 h-6 rounded-full transition-colors duration-300 focus:outline-none ${checked ? 'bg-blue-700' : 'bg-slate-200'}`}
      >
        <span
          className={`absolute top-0.5 w-5 h-5 bg-white rounded-full shadow-sm transition-all duration-300 ${checked ? 'right-0.5' : 'left-0.5'}`}
        />
      </button>
    </div>
  )
}

function SaveButton({ onClick, saving, saved, label = 'حفظ ا�إعدادات' }) {
  return (
    <button
      onClick={onClick}
      disabled={saving}
      className={`flex items-center gap-2 px-6 py-2.5 rounded-xl font-bold text-sm transition-all duration-300 shadow-sm ${
        saved
          ? 'bg-emerald-600 text-white'
          : saving
          ? 'bg-blue-400 text-white cursor-wait'
          : 'bg-blue-700 hover:bg-blue-800 text-white active:scale-95'
      }`}
    >
      {saving ? <Loader2 size={16} className="animate-spin" /> : saved ? <CheckCircle size={16} /> : <Save size={16} />}
      {saved ? 'ت�& ا�حفظ!' : saving ? 'جار�` ا�حفظ...' : label}
    </button>
  )
}

// ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½
// Main Component
// ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½ï¿½
export default function SettingsPage({ user, onSettingsChange }) {
  const [activeTab, setActiveTab] = useState('store')
  const [settings, setSettings] = useState({
    // store
    store_name: '', store_phone: '', store_address: '',
    currency: 'ج.�&', currency_symbol: 'ج.�&',
    tax_rate: '0', tax_enabled: '0',
    invoice_footer: 'شْرا�9 ï¿½ز�`ارتْ�&', store_logo: '',
    // print
    show_logo: '0', show_cashier_name: '1', show_tax: '0',
    auto_print: '1', paper_size: '80mm', printer_name: '',
    print_mode: 'silent', show_barcode: '1', barcode_type: 'CODE128',
    // system
    language: 'ar', date_format: 'DD/MM/YYYY',
    dark_mode: '0', low_stock_alert: '1',
    sale_sound: '1', auto_focus_search: '1', auto_save: '1',
    // users/permissions
    permissions_enabled: '1', prevent_delete_last_admin: '1',
    protect_sensitive_ops: '1', auto_logout_minutes: '0',
    // closing
    day_closing_enabled: '1', cashier_can_close: '1',
    prevent_reopen_by_cashier: '1', prevent_sale_after_close: '1',
    cash_diff_limit: '10', alert_on_diff: '1',
    // backup
    auto_backup: '0',
  })

  const [saving, setSaving] = useState(false)
  const [saved, setSaved] = useState(false)
  const [printers, setPrinters] = useState([])
  const [backupMsg, setBackupMsg] = useState({ text: '', type: '' })
  const [showReset, setShowReset] = useState(false)
  const [licenseInfo, setLicenseInfo] = useState(null)
  const [lastBackup, setLastBackup] = useState(null)
  const logoInputRef = useRef()

  // helpers
  const bool = (key) => settings[key] === '1'
  const setB = (key, val) => set(key, val ? '1' : '0')
  function set(key, val) {
    setSettings(s => ({ ...s, [key]: val }))
  }

  async function loadAll() {
    const data = await window.mgpos.db.getSettings()
    if (data && typeof data === 'object') {
      setSettings(prev => ({ ...prev, ...data }))
    }
    if (window.mgpos.getPrinters) {
      const pr = await window.mgpos.getPrinters()
      setPrinters(pr || [])
    }
    if (window.mgpos.license && window.mgpos.license.check) {
      const lic = await window.mgpos.license.check()
      setLicenseInfo(lic)
    }
  }

  useEffect(() => {
    if (user?.role === 'admin') loadAll()
  }, [user])

  if (user?.role !== 'admin') {
    return (
      <div className="flex flex-col items-center justify-center h-full gap-4 text-slate-400">
        <Shield size={48} className="opacity-30" />
        <p className="font-bold text-lg">غ�`ر �&س�&��ح ï¿½ْ با���ص��� ï¿½�!ذ�! ا�صفحة</p>
      </div>
    )
  }

  async function handleSave() {
    setSaving(true)
    try {
      for (const [key, value] of Object.entries(settings)) {
        await window.mgpos.db.setSetting(key, String(value ?? ''))
      }
      setSaved(true)
      setTimeout(() => setSaved(false), 2500)
      // Notify parent App to refresh settings globally
      if (onSettingsChange) {
        const fresh = await window.mgpos.db.getSettings()
        if (fresh) onSettingsChange(fresh)
      }
    } finally {
      setSaving(false)
    }
  }

  async function handleBackup() {
    const result = await window.mgpos.backup.create()
    if (result?.success) {
      setBackupMsg({ text: 'ت�& إ� شاء ا�ï¿½ سخة ا�احت�`اط�`ة ب� جاح ï¿½S', type: 'success' })
      setLastBackup(new Date().toLocaleString('ar-EG'))
    } else {
      setBackupMsg({ text: 'ت�& ا�إ�غاء', type: 'warn' })
    }
    setTimeout(() => setBackupMsg({ text: '', type: '' }), 3500)
  }

  async function handleRestore() {
    const result = await window.mgpos.backup.restore()
    if (result?.success) {
      alert('ت�& ا�است�`راد ب� جاح! س�`ت�& إعادة تشغ�`� ا�بر� ا�&ج ا�آ� .')
