# ==============================================================================
# NEXA POS SaaS Cloud Server - Hostinger VPS Production Environment Blueprint
# ملف نموذج المتغيرات البيئية لبيئة الإنتاج السحابية (100-Year Architecture)
# ==============================================================================
# تنبيه أمني صارم:
# 1. لا ترفع هذا الملف أو ملف .env الحقيقي أبداً إلى Git أو أي مستودع عام.
# 2. اضبط صلاحيات ملف .env في السيرفر ليكون حصرياً للمستخدم: chmod 600 .env
# 3. ولد المفاتيح التشفيرية العشوائية باستخدام أمر: openssl rand -hex 32
# ==============================================================================

# 1. بيئة التشغيل ومنفذ الخادم الداخلي
NODE_ENV=production
PORT=4000
NODE_OPTIONS=--max-old-space-size=1536

# 2. إعدادات قاعدة بيانات PostgreSQL 16 السحابية المركزية
# يتم إنشاء قاعدة البيانات والمستخدم تلقائياً عند أول تشغيل للحاوية
POSTGRES_DB=nexa_saas
POSTGRES_USER=nexa_admin
# كلمة مرور فائقة التشفير (تولد آلياً بواسطة deploy-hostinger.sh)
POSTGRES_PASSWORD=generate_with_openssl_rand_hex_24

# روابط الاتصال المباشرة داخل شبكة Docker المعزولة (تُملأ تلقائياً في Compose)
# DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# 3. إعدادات محرك الكاش السريع وقوائم الحظر Redis 7
REDIS_PASSWORD=generate_with_openssl_rand_hex_24
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# 4. مفاتيح التشفير والتحقق المشفر من الهوية والتوكنات (JWT & Crypto)
# المفتاح السري لتوقيع توكنات الجلسات (JWT Tokens)
JWT_SECRET=generate_with_openssl_rand_hex_32

# المفتاح الخاص بتوقيع وإصدار رخص أجهزة الكاشير المشفرة (.nexalic) أوفلاين
LICENSE_SIGNING_KEY=generate_with_openssl_rand_hex_32

# 5. نطاق الخادم السحابي وإعدادات SSL المجانية
# ضع هنا النطاق المحجوز على Hostinger الموجه لـ IP السيرفر (A Record)
DOMAIN_NAME=fleet.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# 6. حدود وحجم مجمع اتصالات قاعدة البيانات (DB Pool Tuning)
DB_POOL_MAX=25
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000
