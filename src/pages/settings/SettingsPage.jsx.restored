  { key: 'users',   label: 'ا��&ستخد�&�`�  ��ا�ص�اح�`ات',  icon: Users },
  { key: 'closing', label: 'إ�فا� ا�ï¿½`ï¿½ï¿½ï¿½&',             icon: Lock },
  { key: 'backup',  label: 'ا�ï¿½ سخ ا�احت�`اط�`',         icon: Database },
