              set('currency_symbol', val)
            }}>
              <option value="ج.�&">ج� ï¿½`ï¿½! �&صر�` (ج.�&)</option>
              <option value="ر.س">ر�`ا� سع��د�` (ر.س)</option>
              <option value="د.إ">در�!�& إ�&ارات�` (د.إ)</option>
              <option value="د.ْ">د�`� ار ْ���`ت�` (د.ْ)</option>
              <option value="د.أ">د�`� ار أرد� ï¿½` (د.أ)</option>
              <option value="$">د���ار أ�&ر�`ْ�` ($)</option>
              <option value="��">�`��ر�� (ï¿½ï¿½)</option>
            </Select>
            <Input label="ر�&ز ا�ع�&�ة" value={settings.currency_symbol} onChange={e => set('currency_symbol', e.target.value)} placeholder="ج.�&" />
